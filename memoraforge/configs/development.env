# MemoraForge — Development Environment Configuration

# LLM Backend
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
VLLM_URL=http://localhost:8001
DEFAULT_MODEL=llama3.1:8b

# Memory Hub
WEAVIATE_URL=http://localhost:8080
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memoraforge

# Database
POSTGRES_URL=postgresql://memoraforge:memoraforge@localhost:5432/memoraforge
REDIS_URL=redis://localhost:6379/0

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Service Ports
API_SERVER_PORT=8000
MCP_SERVER_PORT=8100
MEMORY_HUB_PORT=8200
ACP_HANDLER_PORT=8300

# Limits
MAX_CONCURRENT_REQUESTS=32
MAX_CONTEXT_TOKENS=5000000
MAX_LLM_CONTEXT=128000
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL=10

# Security (dev only — rotate in production!)
JWT_SECRET=dev-secret-change-in-production
ENCRYPTION_KEY=dev-key-change-in-production

# Logging
LOG_LEVEL=INFO
