# MemoraForge — Production Environment Configuration
# All secrets should come from Vault/K8s secrets in real deployments

LLM_BACKEND=vllm
VLLM_URL=http://vllm-service:8001
DEFAULT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

WEAVIATE_URL=http://weaviate-service:8080
NEO4J_URI=bolt://neo4j-service:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD}

POSTGRES_URL=postgresql://${PG_USER}:${PG_PASSWORD}@postgres-service:5432/memoraforge
REDIS_URL=redis://redis-sentinel:26379/0

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

MAX_CONCURRENT_REQUESTS=128
MAX_CONTEXT_TOKENS=5000000
MAX_LLM_CONTEXT=128000
RATE_LIMIT_CAPACITY=500
RATE_LIMIT_REFILL=50

LOG_LEVEL=WARNING
