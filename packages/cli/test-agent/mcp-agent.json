{
  "name": "mcp-assistant",
  "version": "1.0.0",
  "description": "AI assistant with MCP server integration",
  "capabilities": ["chat", "reasoning", "mcp-tools"],
  "tools": ["datetime", "text", "json"],
  "instructions": "You are a helpful AI assistant with access to MCP tools. Use them when needed to help the user.",
  "aiProvider": "ollama",
  "llm": {
    "provider": "ollama",
    "model": "mistral:7b",
    "host": "http://localhost:11434"
  },
  "environment": {
    "maxTokens": 2000,
    "temperature": 0.7
  },
  "mcp": {
    "servers": [
      {
        "name": "filesystem",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
      }
    ]
  }
}
